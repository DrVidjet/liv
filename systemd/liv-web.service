# Managed by Liv deploy
[Unit]
Description=Liv web app
After=network.target
[Service]
Type=simple
StateDirectory=liv-web
StateDirectoryMode=0700
User=liv
ExecStart=/usr/bin/python3 /srv/liv-web/current/serve.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
